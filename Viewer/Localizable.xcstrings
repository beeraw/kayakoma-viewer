    "Ce fichier contient du texte qui n'est pas du Markdown. Kayakoma Viewer lit les fichiers Markdown (.md, .markdown) et le texte brut.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier contient du texte qui n'est pas du Markdown. Kayakoma Viewer lit les fichiers Markdown (.md, .markdown) et le texte brut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file contains text that is not Markdown. Kayakoma Viewer reads Markdown files (.md, .markdown) and plain text."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Datei enthält Text, der kein Markdown ist. Kayakoma Viewer liest Markdown-Dateien (.md, .markdown) und reinen Text."
          }
        },
        "es": {
          "stringUnit": {
